// This is your Prisma schema file for ATO
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SolutionType {
  IDEA
  SERVICE
  PRODUCT
}

enum Status {
  OPEN
  CLOSED
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password      String
  role          Role        @default(USER)
  onboarded     Boolean     @default(false)
  userType      String?     // Builder, Founder, Buyer
  industries    String[]
  skills        String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  profile       Profile?
  problems      Problem[]
  solutions     Solution[]
  votes         Vote[]
  transactions  Transaction[]
  products      Product[]
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Problem {
  id          String      @id @default(uuid())
  title       String
  description String      @db.Text
  category    String
  tags        String[]
  status      Status      @default(OPEN)
  demandScore Int         @default(0)
  posterId    String
  poster      User        @relation(fields: [posterId], references: [id], onDelete: Cascade)
  solutions   Solution[]
  votes       Vote[]
  products    Product[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Solution {
  id          String       @id @default(uuid())
  type        SolutionType
  description String       @db.Text
  links       String[]
  problemId   String
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes       Vote[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String    @db.Text
  price       Float
  demoUrl     String?
  downloadUrl String?
  problemId   String
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User      @relation(fields: [sellerId], references: [id], onDelete: Cascade) 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vote {
  id          String   @id @default(uuid())
  value       Int      // 1 for upvote, -1 for downvote
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String?
  problem     Problem? @relation(fields: [problemId], references: [id], onDelete: Cascade)
  solutionId  String?
  solution    Solution? @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@unique([userId, solutionId])
}

model Transaction {
  id            String   @id @default(uuid())
  amount        Float
  currency      String   @default("INR")
  status        String   // PENDING, COMPLETED, FAILED
  paymentId     String?  @unique // Stripe/Razorpay ID
  buyerId       String
  buyer         User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId     String?
  createdAt     DateTime @default(now())
}
